# Application
APP_NAME=찍어보소 API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
DOCS_ENABLED=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# CORS must be a JSON array.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# AI
AI_PROVIDER=fake
UPSTAGE_API_KEY=
UPSTAGE_OFFICIAL_VECTOR_STORE_ID=
UPSTAGE_TEMPLATE_VECTOR_STORE_ID=
UPSTAGE_CASE_VECTOR_STORE_ID=
UPSTAGE_CHAT_MODEL=solar-pro3
AI_PROMPT_VERSION=busan-link-v1
AI_AGENT_MAX_ITERATIONS=2
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=60

# Modusign
MODUSIGN_API_KEY=
MODUSIGN_AUTH_EMAIL=
MODUSIGN_TEMPLATE_ID=
MODUSIGN_WEBHOOK_SECRET=

# Development/demo login. Keep disabled outside a local demo environment.
DEMO_LOGIN_ENABLED=false
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=
