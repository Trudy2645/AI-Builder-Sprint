APP_NAME=BusanLink API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_AUTH_TIMEOUT_SECONDS=5

UPSTAGE_API_KEY=
UPSTAGE_DOCUMENT_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_CHAT_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_AGENT_BASE_URL=https://api.upstage.ai/v2
UPSTAGE_CHAT_MODEL=solar-pro3
UPSTAGE_OFFICIAL_VECTOR_STORE_ID=
UPSTAGE_TEMPLATE_VECTOR_STORE_ID=
AI_PROMPT_VERSION=busan-link-v1
AI_AGENT_MAX_ITERATIONS=2
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=60

MODUSIGN_BASE_URL=https://api.modusign.co.kr
MODUSIGN_API_KEY=
MODUSIGN_AUTH_EMAIL=
MODUSIGN_TEMPLATE_ID=
